# 不要把真实值提交到 Git，也不要发到聊天里。
PORT=4100
GOOGLE_MAPS_API_KEY=replace_with_your_new_key
NETEASE_COOKIE=replace_with_your_netease_cookie
# 本地开发地址；Vercel 上由 Service Binding 注入 NETEASE_PRIVATE_URL，无需填写此项
NETEASE_API_BASE_URL=http://127.0.0.1:3000

# Google 需要代理时填写。Clash/v2rayN 常见 HTTP 端口是 7890。
HTTPS_PROXY=http://127.0.0.1:7890
